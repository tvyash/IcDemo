<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_ic_demo_consolidation_pivot" model="ir.ui.view">
        <field name="name">ic.demo.consolidation.line.pivot</field>
        <field name="model">ic.demo.consolidation.line</field>
        <field name="arch" type="xml">
            <pivot string="Consolidated P&amp;L" sample="1">
                <field name="company_id" type="row"/>
                <field name="period" type="col" interval="month"/>
                <field name="revenue" type="measure"/>
                <field name="receivables" type="measure"/>
                <field name="net_profit" type="measure"/>
                <field name="line_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ic_demo_consolidation_graph" model="ir.ui.view">
        <field name="name">ic.demo.consolidation.line.graph</field>
        <field name="model">ic.demo.consolidation.line</field>
        <field name="arch" type="xml">
            <graph string="Consolidated P&amp;L" type="bar" sample="1" stacked="1">
                <field name="period" interval="month"/>
                <field name="company_id"/>
                <field name="revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_ic_demo_consolidation_list" model="ir.ui.view">
        <field name="name">ic.demo.consolidation.line.list</field>
        <field name="model">ic.demo.consolidation.line</field>
        <field name="arch" type="xml">
            <list string="Consolidated lines">
                <field name="period"/>
                <field name="company_id"/>
                <field name="revenue" sum="Revenue"/>
                <field name="receivables" sum="Receivables"/>
                <field name="net_profit" sum="Net profit"/>
                <field name="line_count" sum="# lines"/>
            </list>
        </field>
    </record>

    <record id="view_ic_demo_consolidation_search" model="ir.ui.view">
        <field name="name">ic.demo.consolidation.line.search</field>
        <field name="model">ic.demo.consolidation.line</field>
        <field name="arch" type="xml">
            <search string="Consolidation">
                <field name="company_id"/>
                <field name="year"/>
                <filter string="Last 12 months" name="last12"
                        domain="[('period','&gt;=',(context_today() - relativedelta(months=12)).strftime('%Y-%m-01'))]"/>
                <filter string="This year" name="this_year"
                        domain="[('period','&gt;=',(context_today().replace(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Company" name="group_company" context="{'group_by':'company_id'}"/>
                    <filter string="Year" name="group_year" context="{'group_by':'year'}"/>
                    <filter string="Month" name="group_month" context="{'group_by':'period:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ic_demo_consolidation" model="ir.actions.act_window">
        <field name="name">Consolidated P&amp;L</field>
        <field name="res_model">ic.demo.consolidation.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_last12': 1, 'search_default_group_company': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No consolidated lines yet</p>
            <p>Post some journal entries in your companies to see the roll-up appear here.</p>
        </field>
    </record>

    <menuitem id="menu_ic_demo_root_consolidation"
              name="IC Demo"
              sequence="30"
              web_icon="account,static/description/icon.png"/>
    <menuitem id="menu_ic_demo_consolidation"
              name="Consolidated P&amp;L"
              parent="menu_ic_demo_root_consolidation"
              action="action_ic_demo_consolidation"
              sequence="10"/>

</odoo>
